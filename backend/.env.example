# ──────────────────────────────────────────────
# WorkForce Tracker — Backend Environment Variables
# Copy this file to .env for local dev.
# On Railway, set these in the service Variables tab.
# ──────────────────────────────────────────────

# PostgreSQL connection string.
# On Railway: link a Postgres service and this is injected automatically.
DATABASE_URL=postgresql://postgres:password@localhost:5432/workforce_tracker

# JWT signing key — REQUIRED, no default.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Token expiry in minutes (default 60 = 1 hour). Increase only if workers complain about re-login frequency.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Set to true only in local dev — disables /docs and /redoc in production
DEBUG=false

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-frontend.up.railway.app,http://localhost:5173

# ── Admin seed (only used on first boot when no admin exists) ──
# REQUIRED on first deploy. Can be removed from Railway vars after first boot.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=

# ── Cloudinary (screenshot uploads) ──
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Web Push / VAPID (push notifications) ──
# Generate your keys ONCE with either of these commands:
#   python -c "from pywebpush import generate_vapid_keys; generate_vapid_keys()"
#   npx web-push generate-vapid-keys
# Paste the output below. Never regenerate these — all existing browser subscriptions will break.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_MAILTO=mailto:admin@yourcompany.com
